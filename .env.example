# Travel Intelligence Engine — environment template.
# Copy to .env and fill real values. .env is gitignored (secrets).

# --- Supabase (cloud project) ---
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_REF=<ref>
SUPABASE_ANON_KEY=                 # Settings > API > anon public  (safe/publishable)
SUPABASE_SERVICE_ROLE_KEY=        # Settings > API > service_role  (SECRET — backend only)

# Direct Postgres connection (for migrations / scripts).
# Settings > Database > Connection string > URI. Password set at project creation.
SUPABASE_DB_URL=postgresql://postgres:<db-password>@db.<ref>.supabase.co:5432/postgres

# --- Pipeline API keys (added in later stages) ---
YOUTUBE_API_KEY=                  # Stage 2: YouTube Data API v3
GOOGLE_PLACES_API_KEY=            # Stage 6/7: Places enrichment

# --- LLM (provider-agnostic, OpenAI-compatible /chat/completions) ---
# Works with any OpenAI-compatible provider: Agnes, OpenAI, DeepSeek, Groq,
# OpenRouter, local (Ollama/LM Studio). Swap provider = change these 3 vars.
LLM_API_KEY=                      # your key
LLM_BASE_URL=                     # e.g. https://api.agnes.ai/v1  (must end in /v1 or provider's base)
LLM_MODEL=                        # main/extraction model, e.g. agnes-2.0-flash
LLM_GATE_MODEL=                   # cheap model for Stage 3 gate (optional; defaults to LLM_MODEL)
